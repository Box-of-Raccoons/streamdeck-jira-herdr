{
	"name": "streamdeck-jira-herdr",
	"version": "0.1.0",
	"private": true,
	"description": "Stream Deck plugin: open-sprint Jira tickets on keys and dials, sent to herdr as new agent sessions.",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.boxofraccoons.jira-herdr\"",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "tsc --noEmit && vitest run"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.1",
		"@elgato/utils": "0.6.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "~24.19.0",
		"rollup": "^4.63.5",
		"tslib": "^2.8.1",
		"typescript": "~5.9.3",
		"vitest": "^5.0.3"
	}
}
